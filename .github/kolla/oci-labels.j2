{#
  Global kolla-build template override.

  It only replaces the `labels` block that every kolla Dockerfile.j2 defines, so
  that the resulting images carry OCI metadata pointing back at this fork. GHCR
  uses org.opencontainers.image.source to link a package to the repository.

  Passed to kolla-build as: --template-override .github/kolla/oci-labels.j2
#}
{% extends parent_template %}

{% block labels %}
LABEL maintainer="{{ maintainer }}" \
      name="{{ image_name }}" \
      build-date="{{ build_date }}" \
      org.opencontainers.image.source="https://github.com/preinpost/kolla" \
      org.opencontainers.image.title="kolla/{{ image_name }}" \
      org.opencontainers.image.version="{{ tag }}" \
      org.opencontainers.image.revision="{{ kolla_version }}" \
      org.opencontainers.image.licenses="Apache-2.0"
{% endblock %}
